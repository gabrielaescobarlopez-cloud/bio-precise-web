# BIO-PRECISE Content Agent — Variables de entorno
# Copia este archivo como .env y completa los valores

# Claude API (obtener en console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Telegram Bot (token del bot @bioprecise_content_bot)
TELEGRAM_TOKEN=XXXX:YYYY...

# Chat IDs de Telegram
CHAT_ID_MARTIN=TU_CHAT_ID
CHAT_ID_GABRIELA=CHAT_ID_DRA_GABRIELA

# Windsor.ai API Key (obtener en windsor.ai → Settings → API)
WINDSOR_API_KEY=...

# Instagram Account ID
INSTAGRAM_ACCOUNT_ID=17841443626145377
